# === Trustline (TOGOSHIELD) backend — variables d'environnement ===
# Copiez ce fichier en ".env" et adaptez.
# Seule DATABASE_URL est réellement obligatoire : tout le reste a un défaut sain.

# --- Django ---
SECRET_KEY=dev-insecure-key-change-me-in-production
DEBUG=True
ALLOWED_HOSTS=*

# --- Base de données (PostgreSQL — OBLIGATOIRE) ---
# Trustline ne fonctionne QUE sur PostgreSQL ; il n'y a plus de repli SQLite.
# Créez la base une fois :  createdb -U postgres trustline
DATABASE_URL=postgres://postgres:VOTRE_MOT_DE_PASSE@localhost:5432/trustline
# Durée de réutilisation des connexions (secondes). 0 = reconnexion à chaque requête.
CONN_MAX_AGE=60

# --- Cache / rate limiting ---
# Par défaut : cache mémoire local (le rate limiting DRF fonctionne quand même).
# Pour brancher Redis quand il est disponible, décommentez :
# CACHE_URL=redis://127.0.0.1:6379/1

# --- Rate limiting (endpoints publics) ---
THROTTLE_ANON=60/min
THROTTLE_USER=240/min

# --- CORS (application mobile, extension Chrome, front Web) ---
CORS_ALLOW_ALL_ORIGINS=True

# --- Sécurité production (HTTPS) ---
# En dev (DEBUG=True) tout est neutre : rien à décommenter.
# En prod (DEBUG=False), ces réglages s'activent automatiquement. À renseigner :
#
# Origines de confiance CSRF (OBLIGATOIRE pour se connecter à /admin/ en HTTPS).
# Avec le schéma, séparées par des virgules :
# CSRF_TRUSTED_ORIGINS=https://api.mondomaine.tg,https://mondomaine.tg
#
# ⚠️ Tant que le certificat HTTPS n'est PAS encore posé (avant certbot),
# désactive la redirection pour éviter une boucle :
# SECURE_SSL_REDIRECT=False
#
# Surcharges optionnelles (défauts = activés si DEBUG=False) :
# USE_X_FORWARDED_PROTO=True        # requis derrière Nginx
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True
# SECURE_HSTS_SECONDS=31536000

# --- Seuils du moteur de détection (score -> niveau_risque) ---
SEUIL_SUSPECT=30
SEUIL_ELEVE=70

# --- Modèle ML optionnel ---
# Vide = moteur en mode règles uniquement (défaut).
# Renseigner le chemin d'un modèle .joblib entraîné (voir ml/train_model.py)
# pour activer automatiquement le mélange règles + ML :
# ML_MODEL_PATH=ml/trustline_model.joblib
# ML_POIDS=0.5

# --- Intégration WhatsApp via Gupshup (Sandbox) ---
# Clé API Gupshup (obligatoire pour l'envoi sortant du webhook WhatsApp).
GUPSHUP_API_KEY=
# Numéro sandbox Gupshup (source des messages sortants).
GUPSHUP_SOURCE=917834811114
# Nom de l'app tel que déclaré sur Gupshup.
GUPSHUP_APP_NAME=TrustLine

# --- Branding des messages sortants (bot / WhatsApp) ---
TRUSTLINE_NOM=Trustline
TRUSTLINE_SITE=trustline.tg
