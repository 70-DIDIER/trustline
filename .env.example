# === Trustline (TOGOSHIELD) backend — variables d'environnement ===
# Copiez ce fichier en ".env" et adaptez si besoin.
# TOUTES ces variables ont un défaut sain : le projet démarre SANS .env.

# --- Django ---
SECRET_KEY=dev-insecure-key-change-me-in-production
DEBUG=True
ALLOWED_HOSTS=*

# --- Base de données ---
# Par défaut : SQLite local (aucune installation requise).
# Pour utiliser PostgreSQL 18, décommentez et adaptez :
# DATABASE_URL=postgres://USER:PASSWORD@localhost:5432/trustline

# --- Cache / rate limiting ---
# Par défaut : cache mémoire local (le rate limiting DRF fonctionne quand même).
# Pour brancher Redis quand il est disponible, décommentez :
# CACHE_URL=redis://127.0.0.1:6379/1

# --- Rate limiting (endpoints publics) ---
THROTTLE_ANON=60/min
THROTTLE_USER=240/min

# --- CORS (extension Chrome + Web Next.js) ---
CORS_ALLOW_ALL_ORIGINS=True

# --- Seuils du moteur de détection (score -> niveau_risque) ---
SEUIL_SUSPECT=30
SEUIL_ELEVE=70
